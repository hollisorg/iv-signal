{
  "name": "iv-signal",
  "productName": "IV Signal",
  "version": "0.1.11",
  "description": "Desktop marketing workstation: a Brand Brain for each brand, posts written once for every network, approval, a calendar and a media library, driven by your own Claude Code, Codex or Hermes.",
  "author": "The Hollis Organization",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "mcp": "node src/mcp/server.js",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "vite": "^8.3.4"
  },
  "main": "./out/main/index.js",
  "build": {
    "appId": "org.hollis.ivsignal",
    "productName": "IV Signal",
    "copyright": "(c) 2026 The Hollis Organization",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "to": "icon.png",
        "from": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IV-Signal-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "IV-Signal-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "IV Signal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-signal-releases",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Hivemind handoff",
        "schemes": [
          "iv-signal"
        ]
      }
    ]
  }
}
